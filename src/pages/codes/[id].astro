---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeLogo from '../../components/CodeLogo.astro';
import CodeFigure from '../../components/CodeFigure.astro';
import { isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const codes = await getCollection('codes', isPublished);
  return codes.map((code) => ({ params: { id: code.id }, props: { code } }));
}

const { code } = Astro.props;
const { Content } = await render(code);
const parent = code.data.parent ? await getEntry(code.data.parent) : undefined;
const d = code.data;

// FLUME and PRISM are built on ADAM: until they have papers of their own, show the platform's, labelled as such.
const papers = d.papers.length > 0 ? { list: d.papers, from: undefined } : parent && parent.data.papers.length > 0 ? { list: parent.data.papers, from: parent.data.name } : undefined;
const evidence = [
  { kind: 'verification', title: 'Verification' },
  { kind: 'performance', title: 'Performance' },
].map((g) => ({ ...g, items: d.evidence.filter((e) => e.kind === g.kind) })).filter((g) => g.items.length > 0);

let n = 0;
const num = () => String(++n).padStart(2, '0');

const facets = [
  { label: 'Physics', items: d.physics },
  { label: 'Methods', items: d.methods },
  { label: 'Parallelism', items: d.parallelism },
].filter((f) => f.items.length > 0);
---

<Base title={d.name} description={d.tagline}>
  <header class="head">
    <h1 class="display">{d.name}</h1>
    {d.logo && <CodeLogo folder={d.logo} name={d.name} size={112} />}
    <p class="lead">{d.tagline}</p>
  </header>

  <section class="sec">
    <p class="label mono">{num()} — Overview</p>
    <div class="overview">
      <div class="prose"><Content /></div>
      {d.figures.length > 0 && <div class="figs">{d.figures.map((f) => <CodeFigure f={f} />)}</div>}
    </div>
  </section>

  {
    evidence.map((g) => (
      <section class="sec">
        <p class="label mono">{num()} — {g.title}</p>
        <ol class="index ev">
          {g.items.map((e) => (
            <li>
              <p class="test">{e.test}</p>
              <p class="result">{e.result}</p>
              <a class="src mono" href={e.source}>source →</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  {
    papers && (
      <section class="sec">
        <p class="label mono">{num()} — {papers.from ? `Reference paper (${papers.from} platform)` : 'Reference paper'}</p>
        <ul class="index">
          {papers.list.map((p) => (
            <li><p class="cite">{p.cite}</p><a class="mono" href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="sec">
    <p class="label mono">{num()} — Facts</p>
    <dl class="facts">
      {parent && (<><dt class="mono">Built on</dt><dd><a href={`/codes/${parent.id}/`}>{parent.data.name}</a></dd></>)}
      <dt class="mono">Status</dt><dd>{d.status}</dd>
      <dt class="mono">Licence</dt><dd>{d.license}</dd>
      {d.docs && (<><dt class="mono">Documentation</dt><dd><a href={d.docs}>{d.docs.replace('https://', '')}</a></dd></>)}
      <dt class="mono">Source</dt><dd><a href={d.repo}>{d.repo.replace('https://', '')}</a></dd>
    </dl>
  </section>

  {
    facets.map((f) => (
      <section class="sec">
        <p class="label mono">{num()} — {f.label}</p>
        <ul class="index facet">{f.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))
  }
</Base>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1rem 2rem; padding: 3rem 0 2rem; }
  h1 { margin: 0 0 0 -0.03em; font-size: clamp(2.4rem, 6vw, 5.5rem); font-weight: 300; }
  .lead { grid-column: 1 / -1; margin: 0.5rem 0 0; max-width: 34rem; color: var(--text-2); }
  .facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.5rem 2rem; margin: 0; border-top: 1px solid var(--text-1); padding-top: 1rem; }
  .facts dt { color: var(--text-3); padding-top: 0.2em; }
  .facts dd { margin: 0; overflow-wrap: anywhere; }
  .facet > li { padding: 0.6rem 0; }
  .figs { display: grid; gap: 2rem; }
  .overview { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 64rem) { .overview { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
  .ev li { display: grid; gap: 0.25rem 1.5rem; }
  @media (min-width: 64rem) { .ev li { grid-template-columns: 2fr 1.4fr auto; align-items: baseline; } }
  .ev p { margin: 0; }
  .test { color: var(--text-2); }
  .result { font-family: var(--f-display); font-stretch: 112%; font-weight: 600; }
  .src { white-space: nowrap; }
  .cite { margin: 0 0 0.3rem; max-width: 46rem; }
</style>
