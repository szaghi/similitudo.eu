---
// Codes as rows: the logo (or its placeholder tile) in a column left of the name, the name set large in light extended type,
// the tagline and the facts beside it.
import type { CollectionEntry } from 'astro:content';
import CodeLogo from './CodeLogo.astro';
interface Props { codes: CollectionEntry<'codes'>[] }
import { langOf, t, href, enIn } from '../i18n';
const { codes } = Astro.props; // taglines are English in every language
const lang = langOf(Astro.url);
const T = t(lang);
---

<ul class="index codes">
  {
    codes.map((c) => (
      <li>
        <div class="ident">
          <span class="slot"><CodeLogo folder={c.data.logo} name={c.data.name} size={56} decorative /></span>
          <a class="cname" href={href(lang, `/codes/${c.id}/`)}>{c.data.name}</a>
        </div>
        <p class="tag" lang={enIn(lang)}>{c.data.tagline}</p>
        <p class="meta mono">{T.kinds.long[c.data.kind]}{c.data.parent && ` · ${T.codes.builtOn(c.data.parent.id.toUpperCase())}`} · {c.data.license}</p>
      </li>
    ))
  }
</ul>

<style>
  li { display: grid; gap: 0.35rem 2rem; }
  .cname { font-family: var(--f-display); font-weight: 300; font-size: clamp(2rem, 3.6vw, 3.25rem); line-height: 0.95; letter-spacing: -0.02em; color: var(--text-1); text-decoration: none; }
  .cname:hover { color: var(--link); }
  /* the logos in one column left of the names (a placeholder tile where a code has none yet) */
  .ident { display: grid; grid-template-columns: 56px minmax(0, 1fr); align-items: center; column-gap: 1.25rem; }
  .slot { display: flex; }
  .tag { margin: 0; max-width: 32rem; }
  .meta { margin: 0; color: var(--text-3); }
  @media (min-width: 64rem) {
    li { grid-template-columns: 1.3fr 1fr; grid-template-rows: auto auto; align-items: end; }
    .ident { grid-row: span 2; }
  }
</style>
