---
// Home hero: the wordmark anchored top-left with the seal stamped beside it, the nav on a hairline datum crossing the
// page (and the gesture), the two-line headline under the wordmark, the mesh readout bottom-right. The text never waits for the mark.
import Seal from './Seal.astro';
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import HeroMesh from './HeroMesh.astro';
import { heroSpec } from '../lib/mesh/front';
import { still, readout } from '../lib/mesh/still';
import { langOf, t, href } from '../i18n';

const lang = langOf(Astro.url);
const T = t(lang);
const initial = readout(T.readout, lang, still(heroSpec(1440, 900)).stats); // shown until the script draws
---

<header class="hero">
  <div class="ground"><HeroMesh /></div>
  <h1 class="word display">similitudo<span class="stamp"><Seal size={64} label="" /></span></h1>
  <div class="toggle"><LangSwitch /><ThemeToggle /></div>
  <div class="intro hero-lead">
    <p class="by">{T.byline.by} <a href={href(lang, '/about/')}>Stefano Zaghi</a>, <span class="role">{T.byline.role}</span></p>
    <p class="lead">{T.lead.map((line, i) => (<>{i > 0 && " "}<span class="line">{line}</span></>))}</p>
  </div>
  <Nav class="hero-nav" />
  <p class="readout mono hero-readout" data-tpl={T.readout}>{initial}</p>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto 1fr auto 1fr auto;
    padding: var(--gutter) var(--edge); /* the text sits in the content frame; the ground stays full-bleed */
    overflow: hidden;
  }
  .ground {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(to right, var(--grid) 1px, transparent 1px), linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .hero > :not(.ground) { position: relative; z-index: 1; }

  .word { grid-row: 1; margin: 0 3rem 0 -0.04em; /* clear of the switches (a column on phones, a row from 48rem) */ font-size: clamp(3.9rem, 11.6vw, calc(0.116 * (var(--maxw) + 2 * var(--gutter)))); line-height: 0.82; }
  .stamp { display: inline-block; vertical-align: top; margin-left: 0.08em; animation: stamp 0.35s cubic-bezier(0.3, 1.6, 0.6, 1) 3.1s backwards; /* stamped last, as the front settles */ }
  .stamp :global(svg) { width: 0.2em; height: 0.2em; }
  @keyframes stamp { from { opacity: 0; transform: scale(1.8); } }
  /* The language and theme switches. Phones: a column of two smaller tiles in the wordmark's 3rem margin (side by side
     they would push the seal under the word), reaching below the wordmark: the byline starts a little lower. */
  .toggle { position: absolute !important; top: var(--gutter); right: var(--edge); z-index: 5 !important; display: flex; flex-direction: column; gap: 0.35rem; }
  .toggle :global(.theme-toggle), .toggle :global(.lang-switch summary) { width: 2rem; height: 2rem; }
  @media (min-width: 48rem) {
    .toggle { flex-direction: row; gap: 0.5rem; }
    .toggle :global(.theme-toggle), .toggle :global(.lang-switch summary) { width: 2.25rem; height: 2.25rem; }
    .word { margin-right: 5.5rem; }
  }

  /* The byline, then the headline, right under the wordmark; each on a plate of the ground so the grid stops at its
     edge. The wrapper is `.hero-lead`: HeroMesh fits the phone front below it. */
  .intro { grid-row: 2; display: grid; justify-items: start; margin-top: 1.4rem; }
  @media (min-width: 48rem) { .intro { margin-top: 1rem; } }
  .by {
    margin: 0;
    padding: 0.15rem 0.6rem 0.2rem 0;
    background: var(--bg);
    color: var(--text-2);
    font-family: var(--f-display);
    font-weight: 450;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.2;
  }
  .by .role { white-space: nowrap; } /* on phones the line breaks after the name, never inside the role */
  .by a { color: var(--text-1); font-weight: 560; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .lead {
    margin: 0.5rem 0 0;
    padding: 0.2rem 0.6rem 0.3rem 0;
    background: var(--bg);
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.6vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: pretty; /* phones: no single-word last line */
  }
  /* The nav is another component: Hero's scoped `.hero > :not(.ground)` does not reach it, so lift it explicitly or the
     canvas sits on top and swallows its clicks. */
  /* The break before "on adaptive grids" holds from 768 px up; on phones the first line cannot fit at headline size,
     so the sentence wraps naturally there (a forced break would strand "simulated" on a line of its own). */
  @media (min-width: 48rem) { .lead .line { display: block; white-space: nowrap; } }
  .hero :global(.hero-nav) { grid-row: 4; position: relative; z-index: 1; }
  .readout { grid-row: 6; align-self: end; margin: 1.25rem 0 0; color: var(--text-3); max-width: 40rem; font-variant-numeric: tabular-nums; }

  /* Parallax as the hero scrolls out: the wordmark lags behind the page (CSS scroll timeline; browsers
     without it simply scroll). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .word { animation: lag-word linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes lag-word { to { translate: 0 32vh; } }

  @media (min-width: 48rem) {
    .ground { background-size: 100px 100px; }
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); column-gap: 2rem; }
    .word, .intro, .hero :global(.hero-nav) { grid-column: 1 / -1; }
    .hero :global(.hero-nav ul) { width: min(100%, 52%); }
    .readout { grid-row: 6; grid-column: 2; align-self: end; text-align: right; margin: 0; }
  }
</style>
