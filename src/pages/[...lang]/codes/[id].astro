---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CodeLogo from '../../../components/CodeLogo.astro';
import CodeFigure from '../../../components/CodeFigure.astro';
import Icon from '../../../components/Icon.astro';

/** A URL shown without its scheme, breakable after each slash (narrow screens wrap at path boundaries, not mid-word). */
const segments = (url: string) => url.replace('https://', '').split('/');
import { isPublished } from '../../../lib/content';
import { langPaths, langOf, t, href, enIn } from '../../../i18n';

export async function getStaticPaths() {
  const codes = await getCollection('codes', isPublished);
  return langPaths().flatMap(({ params }) => codes.map((code) => ({ params: { ...params, id: code.id }, props: { code } })));
}

const { code } = Astro.props;
const lang = langOf(Astro.url);
const T = t(lang);
// The code's own words are English in every language (only the labels are translated): marked lang="en" on the other
// languages' pages, so screen readers switch voice.
const d = code.data;
const { Content } = await render(code);
const en = enIn(lang);
const parent = code.data.parent ? await getEntry(code.data.parent) : undefined;

// FLUME and PRISM are built on ADAM: until they have papers of their own, show the platform's, labelled as such.
const papers = d.papers.length > 0 ? { list: d.papers, from: undefined } : parent && parent.data.papers.length > 0 ? { list: parent.data.papers, from: parent.data.name } : undefined;
const evidence = [
  { kind: 'verification', title: T.code.verification },
  { kind: 'performance', title: T.code.performance },
].map((g) => ({ ...g, items: d.evidence.filter((e) => e.kind === g.kind) })).filter((g) => g.items.length > 0);

let n = 0;
const num = () => String(++n).padStart(2, '0');

const facets = [
  { label: T.code.physics, items: d.physics },
  { label: T.code.methods, items: d.methods },
  { label: T.code.parallelism, items: d.parallelism },
].filter((f) => f.items.length > 0);
---

<Base title={d.name} description={d.tagline}>
  <header class="head">
    <div class="ident">
      <h1 class="display">{d.name}</h1>
      {d.logo && <CodeLogo folder={d.logo} name={d.name} size={112} />}
    </div>
    <p class="lead" lang={en}>{d.tagline}</p>
  </header>

  <section class="sec">
    <p class="label mono">{num()} — {T.code.overview}</p>
    <div class:list={['overview', { flow: d.figures.length > 2 }]} lang={en}>
      <div class="prose"><Content /></div>
      {d.figures.length > 0 && d.figures.length <= 2 && <div class="figs">{d.figures.map((f) => <CodeFigure f={f} />)}</div>}
    </div>
  </section>

  {
    d.figures.length > 2 && (
      <section class="sec">
        <p class="label mono">{num()} — {T.code.gallery}</p>
        <div class="gallery" lang={en}>{d.figures.map((f) => <div class:list={[{ wide: f.width / f.height >= 3 }]}><CodeFigure f={f} /></div>)}</div>
      </section>
    )
  }

  {
    evidence.map((g) => (
      <section class="sec">
        <p class="label mono">{num()} — {g.title}</p>
        <ol class="index ev" lang={en}>
          {g.items.map((e) => (
            <li>
              <p class="test">{e.test}</p>
              <p class="result">{e.result}</p>
              <a class="src mono" href={e.source}>{T.code.sourceLink} →</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  {
    papers && (
      <section class="sec">
        <p class="label mono">{num()} — {papers.from ? T.code.paperFrom(papers.from) : T.code.paper}</p>
        <ul class="index">
          {papers.list.map((p) => (
            <li><p class="cite" lang={en}>{p.cite}</p><a class="mono" href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="sec">
    <p class="label mono">{num()} — {T.code.facts}</p>
    <dl class="facts">
      {parent && (<><dt class="mono"><Icon name="stack" size="1.7em" />{T.code.builtOn}</dt><dd><a href={href(lang, `/codes/${parent.id}/`)}>{parent.data.name}</a></dd></>)}
      <dt class="mono"><Icon name="sprout" size="1.7em" />{T.code.status}</dt><dd>{T.code.statuses[d.status]}</dd>
      <dt class="mono"><Icon name="key" size="1.7em" />{T.code.licence}</dt><dd>{d.license}</dd>
      {d.docs && (<><dt class="mono"><Icon name="book" size="1.7em" />{T.code.docs}</dt><dd><a href={d.docs}>{segments(d.docs).map((s, i) => (<>{i > 0 && <>/<wbr /></>}{s}</>))}</a></dd></>)}
      <dt class="mono"><Icon name="branch" size="1.7em" />{T.code.source}</dt><dd><a href={d.repo}>{segments(d.repo).map((s, i) => (<>{i > 0 && <>/<wbr /></>}{s}</>))}</a></dd>
    </dl>
  </section>

  {
    facets.map((f) => (
      <section class="sec">
        <p class="label mono">{num()} — {f.label}</p>
        <ul class="index facet" lang={en}>{f.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))
  }
</Base>

<style>
  /* the logo (when present) sits right after the name; flex, not grid: a grid max-content track measured the
     extended display face ~50 px wider than its glyphs. A logo that does not fit wraps under the name. */
  .head { padding: 3rem 0 2rem; }
  .ident { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  h1 { margin: 0 0 0 -0.03em; font-size: clamp(2.4rem, 6vw, 5.5rem); font-weight: 300; }
  .lead { margin: 1.5rem 0 0; max-width: 34rem; color: var(--text-2); }
  .facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.5rem 2rem; margin: 0; border-top: 1px solid var(--text-1); padding-top: 1rem; }
  .facts dt { display: flex; align-items: center; gap: 0.5rem; color: var(--text-3); --icon-ink: var(--text-2); }
  .facts dd { margin: 0; overflow-wrap: anywhere; }
  .facet > li { padding: 0.6rem 0; }
  .figs { display: grid; gap: 2rem; }
  /* More than two figures: a gallery under the overview instead of a tall column beside it. */
  .gallery { display: grid; gap: 2.5rem 2rem; }
  /* a strip of 3:1 or wider spans the row (at half width it would be a sliver); dense packing lets the next figure fill
     the gap beside the one before it */
  @media (min-width: 64rem) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: row dense; align-items: start; }
    .gallery > .wide { grid-column: 1 / -1; }
  }
  .overview { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 64rem) { .overview { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
  /* With a gallery the figures sit in their own section: the overview takes the whole row, in two text columns. */
  @media (min-width: 64rem) {
    .overview.flow { grid-template-columns: minmax(0, 1fr); }
    .overview.flow .prose { max-width: none; columns: 2; column-gap: 3rem; }
    .overview.flow .prose :global(p) { margin-top: 0; }
  }
  .ev li { display: grid; gap: 0.25rem 1.5rem; }
  @media (min-width: 64rem) { .ev li { grid-template-columns: 2fr 1.4fr auto; align-items: baseline; } }
  .ev p { margin: 0; }
  .test { color: var(--text-2); }
  .result { font-family: var(--f-display); font-weight: 600; }
  .src { white-space: nowrap; }
  .cite { margin: 0 0 0.3rem; max-width: 46rem; }
</style>
