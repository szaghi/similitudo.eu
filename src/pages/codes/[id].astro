---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeLogo from '../../components/CodeLogo.astro';
import { isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const codes = await getCollection('codes', isPublished);
  return codes.map((code) => ({ params: { id: code.id }, props: { code } }));
}

const { code } = Astro.props;
const { Content } = await render(code);
const parent = code.data.parent ? await getEntry(code.data.parent) : undefined;
const d = code.data;

const facets = [
  { label: 'Physics', items: d.physics },
  { label: 'Methods', items: d.methods },
  { label: 'Parallelism', items: d.parallelism },
].filter((f) => f.items.length > 0);
---

<Base title={d.name} description={d.tagline}>
  <header class="head">
    <h1 class="display">{d.name}</h1>
    {d.logo && <CodeLogo folder={d.logo} name={d.name} size={112} />}
    <p class="lead">{d.tagline}</p>
  </header>

  <section class="sec">
    <p class="label mono">01 — Facts</p>
    <dl class="facts">
      {parent && (<><dt class="mono">Built on</dt><dd><a href={`/codes/${parent.id}/`}>{parent.data.name}</a></dd></>)}
      <dt class="mono">Status</dt><dd>{d.status}</dd>
      <dt class="mono">Licence</dt><dd>{d.license}</dd>
      <dt class="mono">Source</dt><dd><a href={d.repo}>{d.repo.replace('https://', '')}</a></dd>
      {d.docs && (<><dt class="mono">Documentation</dt><dd><a href={d.docs}>{d.docs.replace('https://', '')}</a></dd></>)}
    </dl>
  </section>

  <section class="sec">
    <p class="label mono">02 — Overview</p>
    <div class="prose"><Content /></div>
  </section>

  {
    facets.map((f, k) => (
      <section class="sec">
        <p class="label mono">{String(k + 3).padStart(2, '0')} — {f.label}</p>
        <ul class="index facet">{f.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))
  }
</Base>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1rem 2rem; padding: 3rem 0 2rem; }
  h1 { margin: 0 0 0 -0.03em; font-size: clamp(2.4rem, 6vw, 5.5rem); font-weight: 300; }
  .lead { grid-column: 1 / -1; margin: 0.5rem 0 0; max-width: 34rem; color: var(--text-2); }
  .facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.5rem 2rem; margin: 0; border-top: 1px solid var(--text-1); padding-top: 1rem; }
  .facts dt { color: var(--text-3); padding-top: 0.2em; }
  .facts dd { margin: 0; overflow-wrap: anywhere; }
  .facet > li { padding: 0.6rem 0; }
</style>
