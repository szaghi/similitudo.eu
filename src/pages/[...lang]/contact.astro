---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { email } from '../../lib/site';
import Icon from '../../components/Icon.astro';
import { langPaths, langOf, t } from '../../i18n';

export const getStaticPaths = langPaths;
const T = t(langOf(Astro.url));
---

<Base title={T.contact.title} description={T.contact.description}>
  <PageHead title={T.contact.title} lead={T.contact.lead} />
  <section class="sec">
    <p class="label mono">01 — {T.contact.email}</p>
    <p class="mail"><a class="display" href={`mailto:${email}`}><Icon name="mail" size="1.15em" tile />{email}</a></p>
  </section>
</Base>

<style>
  .mail { margin: 0; }
  .mail a { display: inline-flex; align-items: center; gap: 0.4em; font-size: clamp(1.3rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; overflow-wrap: anywhere; text-decoration-thickness: 1px; }
</style>
