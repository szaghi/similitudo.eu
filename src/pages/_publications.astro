---
// PARKED (docs/TODO.md): the leading underscore keeps this page out of the build. To restore it, drop the underscore
// and add it back to `nav` in src/lib/site.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { isPublished } from '../lib/content';

const pubs = (await getCollection('publications', isPublished)).sort((a, b) => b.data.year - a.data.year);
const years = [...new Set(pubs.map((p) => p.data.year))];
---

<Base title="Publications" description="Publications and talks.">
  <PageHead title="Publications" count={pubs.length} lead="Papers, talks and reports." />

  {pubs.length === 0 && <p class="muted">The publication list is in preparation.</p>}

  {
    years.map((y) => (
      <section class="sec">
        <p class="label mono">{y}</p>
        <ol class="index">
          {pubs
            .filter((p) => p.data.year === y)
            .map((p) => (
              <li class="pub">
                <p class="t">{p.data.title}{p.data.draft && <span class="mono draft"> · draft</span>}</p>
                <p class="a">{p.data.authors.join(', ')}. <em>{p.data.venue}</em>, {p.data.year}.</p>
                <p class="mono l">
                  {p.data.kind}
                  {p.data.doi && <> · <a href={`https://doi.org/${p.data.doi}`}>doi:{p.data.doi}</a></>}
                  {!p.data.doi && p.data.url && <> · <a href={p.data.url}>link</a></>}
                </p>
              </li>
            ))}
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .pub p { margin: 0; max-width: var(--measure); }
  .t { font-family: var(--f-display); font-stretch: 112%; font-weight: 600; font-size: 1.15rem; line-height: 1.3; }
  .a { color: var(--text-2); margin-top: 0.25rem !important; }
  .l { color: var(--text-3); margin-top: 0.35rem !important; }
  .draft { color: var(--seal); }
</style>
