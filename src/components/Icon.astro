---
// A sumi brush icon (src/lib/icons.ts, generated by scripts/brush-icons.py): ink in `--icon-ink` (default text-1),
// optionally on the faint grid tile of the code logos. Decorative: the text beside it always says what it is.
// Inside a link, the ink turns vermilion with the link on hover and focus.
import { icons, iconGrid, type IconName } from '../lib/icons';
interface Props { name: IconName; size?: string; tile?: boolean }
const { name, size = '1.25em', tile = false } = Astro.props;
---

<svg class="icon" viewBox="0 0 64 64" style={`width:${size};height:${size}`} aria-hidden="true" focusable="false">{tile && <path class="tile" d={iconGrid} />}<path class="ink" d={icons[name]} /></svg>

<style>
  .icon { flex: none; overflow: visible; }
  .tile { fill: none; stroke: var(--grid-fine); stroke-width: 0.6; stroke-opacity: 0.45; }
  .ink { fill: var(--icon-ink, var(--text-1)); transition: fill 0.15s; }
  :global(a:hover) .ink, :global(a:focus-visible) .ink { fill: var(--link); }
</style>
