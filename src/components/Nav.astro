---
// The nav on its hairline datum: numbered, large, clearly clickable labels. Each label sits on an opaque plate of the
// ground colour, so grid lines (and the hero mesh) stop at its edge instead of running through the text.
import { nav, isCurrent, pad } from '../lib/site';
interface Props { class?: string }
const { class: cls } = Astro.props;
const here = Astro.url.pathname;
---

<nav class:list={['datum', cls]} aria-label="Main">
  <ul>
    {
      nav.map((n, k) => (
        <li>
          <a href={n.href} aria-current={isCurrent(here, n.href) ? 'page' : undefined}>
            <span class="n mono">{pad(k)}</span>
            <span class="t">{n.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .datum { border-top: 1px solid var(--text-1); }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; list-style: none; margin: 0; padding: 0; }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem 0.65rem 0;
    background: var(--bg);
    color: var(--text-1);
    text-decoration: none;
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 500;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .n { color: var(--text-3); font-size: 0.75rem; letter-spacing: 0; align-self: flex-start; padding-top: 0.2em; }
  .t { text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 0.2em; transition: text-decoration-color 0.15s; }
  .arrow { color: var(--link); opacity: 0; translate: -0.3em 0; transition: opacity 0.15s, translate 0.15s; }
  a:hover .t, a:focus-visible .t { text-decoration-color: currentColor; }
  a:hover .arrow, a:focus-visible .arrow { opacity: 1; translate: none; }
  a[aria-current='page'] .t { text-decoration-color: var(--seal); }
  @media (min-width: 48rem) {
    ul { display: flex; justify-content: space-between; }
  }
</style>
