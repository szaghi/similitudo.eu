---
// Home page only: quantised scrolling. One wheel gesture (any amount, any speed, including a trackpad's inertia tail)
// or one PageDown / PageUp / Space moves exactly one step: hero → Capabilities → Codes → footer, and back. A section
// taller than the screen is paged through one screen at a time, so no content is ever skipped.
// Left native on purpose: touch swipes (phones and tablets), arrow keys, Home / End, the scroll bar, Find in page and
// anchor links. Reduced motion: the step is a jump, without the glide.
---

<script>
  const root = document.documentElement;
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GLIDE = 700; // ms per step
  const QUIET = 220; // ms without wheel events that separate two gestures

  const offset = () => bar?.offsetHeight ?? 0; // the sticky bar covers the top of every stop after the hero
  const maxY = () => root.scrollHeight - window.innerHeight;

  const stops = () => {
    const els = [document.querySelector('.hero'), ...document.querySelectorAll('main .sec'), document.querySelector('.site-footer')];
    const ys = els
      .filter((el): el is Element => !!el)
      .map((el, i) => (i === 0 ? 0 : Math.round(el.getBoundingClientRect().top + window.scrollY - offset())))
      .map((y) => Math.min(Math.max(0, y), maxY()));
    ys.push(maxY());
    return [...new Set(ys)].sort((a, b) => a - b);
  };

  const target = (dir: 1 | -1) => {
    const y = window.scrollY;
    const st = stops();
    const page = window.innerHeight - offset() - 48; // a screen, with a little overlap for context
    if (dir > 0) {
      const next = st.find((s) => s > y + 2) ?? maxY();
      return next - y > page + 48 ? y + page : next; // long section: page through it first
    }
    const prev = [...st].reverse().find((s) => s < y - 2) ?? 0;
    return y - prev > page + 48 ? y - page : prev;
  };

  let busy = false;
  let lastWheel = -Infinity;

  const glide = (to: number) => {
    const from = window.scrollY;
    if (Math.abs(to - from) < 1) return;
    if (still) { window.scrollTo(0, to); return; }
    busy = true;
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / GLIDE);
      window.scrollTo(0, from + (to - from) * ease(t));
      if (t < 1) requestAnimationFrame(step);
      else busy = false;
    };
    requestAnimationFrame(step);
  };

  const blocked = () => root.classList.contains('menu-open');

  window.addEventListener(
    'wheel',
    (e) => {
      if (e.ctrlKey || blocked() || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return; // zoom, menu, sideways: native
      e.preventDefault();
      const now = performance.now();
      const newGesture = now - lastWheel > QUIET;
      lastWheel = now;
      if (busy || !newGesture) return; // the rest of this gesture (and its inertia) is absorbed
      glide(target(e.deltaY > 0 ? 1 : -1));
    },
    { passive: false },
  );

  window.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if (blocked() || e.altKey || e.ctrlKey || e.metaKey || el.closest('input, textarea, select, [contenteditable]')) return;
    const dir = e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey) ? 1 : e.key === 'PageUp' || (e.key === ' ' && e.shiftKey) ? -1 : 0;
    if (!dir || (e.key === ' ' && el.closest('a, button'))) return;
    e.preventDefault();
    if (!busy) glide(target(dir as 1 | -1));
  });
</script>
