---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CapabilityRows from '../components/CapabilityRows.astro';
import CodeGrid from '../components/CodeGrid.astro';
import CompareFigure from '../components/CompareFigure.astro';
import PubRows from '../components/PubRows.astro';
import MoreLink from '../components/MoreLink.astro';
import { isPublished, byOrder } from '../lib/content';

const codes = (await getCollection('codes', isPublished)).sort(byOrder);
// The compare figures of the codes (a result and what carries it), each linked to its code's page.
const inside = codes.flatMap((c) =>
  c.data.figures.flatMap((f) => (f.compare ? [{ f: { ...f, compare: f.compare }, more: { href: `/codes/${c.id}/`, text: c.data.name } }] : [])),
);
const selected = (await getCollection('publications', isPublished))
  .filter((p) => p.data.kind === 'journal')
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
---

<Base home>
  <Hero />
  <main id="main" class="page">
    <section class="sec">
      <p class="label mono">01 — Expertise</p>
      <div>
        <CapabilityRows compact />
        <MoreLink href="/expertise/" icon="grid">Details and documentation</MoreLink>
      </div>
    </section>

    {
      inside.length > 0 && (
        <section class="sec">
          <p class="label mono">02 — Under the surface</p>
          <div class="inside">{inside.map((i) => <div style={`--ar: ${i.f.width / i.f.height}`}><CompareFigure f={i.f} more={i.more} /></div>)}</div>
        </section>
      )
    }

    <section class="sec">
      <p class="label mono">03 — Codes</p>
      <div>
        <CodeGrid codes={codes} />
        <MoreLink href="/codes/" icon="braces">All codes</MoreLink>
      </div>
    </section>

    <section class="sec">
      <p class="label mono">04 — Selected publications</p>
      <div>
        <PubRows pubs={selected} />
        <MoreLink href="/about/publications/" icon="scroll">All publications</MoreLink>
      </div>
    </section>
  </main>
</Base>

<style>
  /* The compare figures side by side at one height: each takes a share of the row equal to its aspect ratio. */
  .inside { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 64rem) {
    .inside { display: flex; align-items: flex-start; }
    .inside > div { flex: var(--ar) 1 0; min-width: 0; }
  }
</style>
