---
// PARKED (docs/TODO.md): the leading underscore keeps this page out of the build. To restore it, drop the underscore
// and add it back to `nav` in src/lib/site.ts; it is still English-only: move its words into src/i18n/ first.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import { isPublished } from '../../lib/content';
import { langPaths } from '../../i18n';

export const getStaticPaths = langPaths;

const projects = (await getCollection('projects', isPublished)).sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
---

<Base title="Projects" description="Research projects similitudo takes part in.">
  <PageHead title="Projects" count={projects.length} mark lead="Research projects similitudo takes part in, and the role it plays in each." />
  {projects.length > 0 ? <ProjectRows projects={projects} /> : <p class="muted">The project list is in preparation.</p>}
</Base>
