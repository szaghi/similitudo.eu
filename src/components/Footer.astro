---
import Seal from './Seal.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row">
    <Seal size={18} label="" />
    <span>© {year} Stefano Zaghi · similitudo.eu</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--divider);
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
</style>
