---
// Self-hosted fonts (no Google Fonts request: avoids sending visitors' IPs to a third party, a GDPR issue for an EU site).
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Reveal from '../components/Reveal.astro';
import { description as SITE_DESCRIPTION, email } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean; // the home page draws its own hero (with the nav) and its own <main>
}


const SITE = 'similitudo';
const DEFAULT_DESCRIPTION = `similitudo: ${SITE_DESCRIPTION.charAt(0).toLowerCase()}${SITE_DESCRIPTION.slice(1)}`;

const { title, description = DEFAULT_DESCRIPTION, home = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : SITE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site); // regenerate with `./site og`

// Structured data: the site, and the person behind it. A Person, not an Organization: similitudo is not a legal entity.
const site = Astro.site!.href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}#website`, url: site, name: SITE, description: DEFAULT_DESCRIPTION, inLanguage: 'en', publisher: { '@id': `${site}#person` } },
    {
      '@type': 'Person',
      '@id': `${site}#person`,
      name: 'Stefano Zaghi',
      url: `${site}about/`,
      email: `mailto:${email}`,
      jobTitle: 'Research scientist',
      affiliation: { '@type': 'Organization', name: 'CNR Istituto per le Applicazioni del Calcolo', url: 'https://www.iac.cnr.it/' },
      sameAs: ['https://github.com/szaghi', 'https://orcid.org/0000-0001-9834-9590'],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ecebe6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1b1a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="similitudo: a blast front drawn as an ink circle over an adaptive grid" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Apply a stored theme choice before first paint (no flash). Storage can throw in private mode.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {
      home ? (
        <slot />
      ) : (
        <>
          <Header />
          <main id="main" class="page">
            <slot />
          </main>
        </>
      )
    }
    <Footer />
    <StickyBar />
    <Reveal />
  </body>
</html>
