---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CapabilityRows from '../components/CapabilityRows.astro';
import CodeRows from '../components/CodeRows.astro';
import { isPublished, byOrder } from '../lib/content';
import QuantumScroll from '../components/QuantumScroll.astro';

const codes = (await getCollection('codes', isPublished)).sort(byOrder);
---

<Base home>
  <Hero />
  <main id="main" class="page">
    <section class="sec">
      <p class="label mono">01 — Capabilities</p>
      <div>
        <CapabilityRows />
        <p class="more"><a href="/capabilities/">Capabilities</a> <span aria-hidden="true">→</span></p>
      </div>
    </section>

    <section class="sec">
      <p class="label mono">02 — Codes</p>
      <div>
        <CodeRows codes={codes} />
        <p class="more"><a href="/codes/">All codes</a> <span aria-hidden="true">→</span></p>
      </div>
    </section>
  </main>
  <QuantumScroll />
</Base>
