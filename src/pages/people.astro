---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PubRows from '../components/PubRows.astro';
import { isPublished, byOrder } from '../lib/content';
import { pad } from '../lib/site';

// Publications live under People (one author today): the newest journal articles here, the full list on its own page.
const pubs = await getCollection('publications', isPublished);
const selected = pubs.filter((p) => p.data.kind === 'journal').sort((a, b) => b.data.year - a.data.year).slice(0, 4);

const people = await Promise.all(
  (await getCollection('people', isPublished))
    .sort(byOrder)
    .map(async (p) => ({ p, Content: (await render(p)).Content })),
);
---

<Base title="People" description="Stefano Zaghi, the person behind similitudo.">
  <PageHead title="People" />
  {
    people.map(({ p, Content }, k) => (
      <article class="sec">
        <p class="label mono">{pad(k)} — {p.data.role}</p>
        <div>
          <h2 class="name">{p.data.name}</h2>
          <div class="prose"><Content /></div>
          <p class="links mono">
            {p.data.orcid && <a href={`https://orcid.org/${p.data.orcid}`}>ORCID</a>}
            {p.data.links.map((l) => <a href={l.url}>{l.label}</a>)}
            {p.data.cv && <a href={p.data.cv}>CV (PDF)</a>}
          </p>
        </div>
      </article>
    ))
  }
  {
    selected.length > 0 && (
      <section class="sec">
        <p class="label mono">{pad(people.length)} — Selected publications</p>
        <div>
          <PubRows pubs={selected} />
          <p class="more"><a href="/people/publications/">All publications ({pubs.length})</a> <span aria-hidden="true">→</span></p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .name { margin: 0 0 1rem; font-family: var(--f-display); font-stretch: 125%; font-weight: 560; font-size: clamp(1.35rem, 2.2vw, 1.8rem); letter-spacing: -0.02em; line-height: 1.1; }
  .links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin: 1rem 0 0; }
</style>
