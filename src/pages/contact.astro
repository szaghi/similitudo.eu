---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { email } from '../lib/site';
---

<Base title="Contact" description="How to reach Stefano Zaghi.">
  <PageHead title="Contact" lead="A question about one of the codes, or an idea for a collaboration? Write to me." />
  <section class="sec">
    <p class="label mono">01 — Email</p>
    <p class="mail"><a class="display" href={`mailto:${email}`}>{email}</a></p>
  </section>
</Base>

<style>
  .mail { margin: 0; }
  .mail a { font-size: clamp(1.3rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; overflow-wrap: anywhere; text-decoration-thickness: 1px; }
</style>
