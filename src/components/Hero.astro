---
// Home hero: the wordmark anchored top-left with the seal stamped beside it, the nav on a hairline datum crossing the
// page (and the gesture), the lead bottom-left, the mesh readout bottom-right. The text never waits for the mark.
import Seal from './Seal.astro';
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
import HeroMesh from './HeroMesh.astro';
import { heroSpec } from '../lib/mesh/front';
import { still } from '../lib/mesh/still';
import { lead } from '../lib/site';

const initial = still(heroSpec(1440, 900)).readout; // shown until the script draws
---

<header class="hero">
  <div class="ground"><HeroMesh /></div>
  <h1 class="word display">similitudo<span class="stamp"><Seal size={64} label="" /></span></h1>
  <div class="toggle"><ThemeToggle /></div>
  <p class="lead hero-lead">{lead}</p>
  <Nav class="hero-nav" />
  <p class="readout mono hero-readout">{initial}</p>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto 1fr auto 1fr auto;
    padding: var(--gutter);
    overflow: hidden;
  }
  .ground {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(to right, var(--grid) 1px, transparent 1px), linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .hero > :not(.ground) { position: relative; z-index: 1; }

  .word { grid-row: 1; margin: 0 3rem 0 -0.04em; font-size: clamp(3.1rem, 11.6vw, 13.5rem); line-height: 0.82; }
  .stamp { display: inline-block; vertical-align: top; margin-left: 0.08em; animation: stamp 0.35s cubic-bezier(0.3, 1.6, 0.6, 1) 3.1s backwards; /* stamped last, as the front settles */ }
  .stamp :global(svg) { width: 0.2em; height: 0.2em; }
  @keyframes stamp { from { opacity: 0; transform: scale(1.8); } }
  .toggle { position: absolute !important; top: var(--gutter); right: var(--gutter); }

  /* The headline sits right under the wordmark; on a plate of the ground so the grid stops at its edge. */
  .lead {
    grid-row: 2;
    justify-self: start;
    margin: 1.25rem 0 0;
    padding: 0.2rem 0.6rem 0.3rem 0;
    max-width: 22em;
    background: var(--bg);
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 400;
    font-size: clamp(1.35rem, 2.6vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  /* The nav is another component: Hero's scoped `.hero > :not(.ground)` does not reach it, so lift it explicitly or the
     canvas sits on top and swallows its clicks. */
  .hero :global(.hero-nav) { grid-row: 4; position: relative; z-index: 1; }
  .readout { grid-row: 6; align-self: end; margin: 1.25rem 0 0; color: var(--text-3); max-width: 40rem; font-variant-numeric: tabular-nums; }

  /* Parallax as the hero scrolls out: the wordmark lags behind the page (CSS scroll timeline; browsers
     without it simply scroll). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .word { animation: lag-word linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes lag-word { to { translate: 0 32vh; } }

  @media (min-width: 48rem) {
    .ground { background-size: 100px 100px; }
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); column-gap: 2rem; }
    .word, .lead, .hero :global(.hero-nav) { grid-column: 1 / -1; }
    .hero :global(.hero-nav ul) { width: min(100%, 52%); }
    .readout { grid-row: 6; grid-column: 2; align-self: end; text-align: right; margin: 0; }
  }
</style>
