---
// The nav on its hairline datum: numbered, large, clearly clickable labels. Each label sits on an opaque plate of the
// ground colour, so grid lines (and the hero mesh) stop at its edge instead of running through the text.
import { nav, isCurrent, pad } from '../lib/site';
import CodeLogo from './CodeLogo.astro';
interface Props {
  class?: string;
  ring?: { id: string; name: string; logo: string }[]; // code logos orbiting the Codes link (home hero, desktop)
}
const { class: cls, ring = [] } = Astro.props;
const size = 24; // logo, px
// A circle centred on the visible "02 Codes". Where the orbit shows, that link drops its hover arrow (the underline
// stays), so its box hugs the text: at most ~61 px right and ~49 px left of the centre, 22 px above and below. A
// radius of 84 clears the box with the logos' half size and a margin; the li margins give the neighbours the same
// clearance (~100 px from the centre), measured at 1152 and 1440 px.
const radius = 84;
const at = (k: number) => {
  const a = -Math.PI / 2 + (2 * Math.PI * k) / ring.length; // from the top, clockwise
  return { x: radius * Math.cos(a), y: radius * Math.sin(a) };
};
const here = Astro.url.pathname;
---

<nav class:list={['datum', cls]} aria-label="Main">
  <ul>
    {
      nav.map((n, k) => (
        <li class:list={[{ ringed: n.href === '/codes/' && ring.length > 0 }]}>
          <a href={n.href} aria-current={isCurrent(here, n.href) ? 'page' : undefined}>
            <span class="n mono">{pad(k)}</span>
            <span class="t">{n.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          {n.href === '/codes/' && ring.length > 0 && (
            <div class="orbit" aria-hidden="true">
              {ring.map((c, i) => {
                const { x, y } = at(i);
                return (
                  <a class="dot" href={`/codes/${c.id}/`} tabindex="-1" title={c.name}
                     style={`left:calc(50% + ${x.toFixed(1)}px - ${size / 2}px);top:calc(50% + ${y.toFixed(1)}px - ${size / 2}px)`}>
                    <CodeLogo folder={c.logo} name={c.name} size={size} decorative />
                  </a>
                );
              })}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .datum { border-top: 1px solid var(--text-1); }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; list-style: none; margin: 0; padding: 0; }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem 0.65rem 0;
    background: var(--bg);
    color: var(--text-1);
    text-decoration: none;
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 500;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .n { color: var(--text-3); font-size: 0.75rem; letter-spacing: 0; align-self: flex-start; padding-top: 0.2em; }
  .t { text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 0.2em; transition: text-decoration-color 0.15s; }
  .arrow { color: var(--link); opacity: 0; translate: -0.3em 0; transition: opacity 0.15s, translate 0.15s; }
  a:hover .t, a:focus-visible .t { text-decoration-color: currentColor; }
  a:hover .arrow, a:focus-visible .arrow { opacity: 1; translate: none; }
  a[aria-current='page'] .t { text-decoration-color: var(--seal); }
  /* the orbit: decorative shortcuts (hidden from assistive tech and the tab order, the Codes link is the real one) */
  li { position: relative; }
  .orbit { display: none; position: absolute; left: calc(50% - 0.375rem); top: 50%; width: 0; height: 0; pointer-events: none; } /* 0.375rem: half the link's right padding */
  /* faint until the cursor is on a logo: then that one alone comes up to full strength */
  .orbit .dot { position: absolute; display: block; line-height: 0; padding: 0; background: var(--bg); pointer-events: auto; opacity: 0.25; transition: opacity 0.2s ease, transform 0.2s ease; }
  .orbit .dot:hover { opacity: 1; transform: scale(1.4); }
  @media (min-width: 48rem) {
    ul { display: flex; justify-content: space-between; }
  }
  /* from 1280 px: below it the blast ring (~0.6 of the width) would reach Contact, pushed ~84 px by the margins */
  @media (min-width: 80rem) {
    .orbit { display: block; }
    .ringed { margin: 0 2.25rem 0 3rem; }
    .ringed .arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .orbit .dot { transition: none; } }
</style>
