---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CodeRows from '../../components/CodeRows.astro';
import { isPublished, byOrder } from '../../lib/content';

const codes = (await getCollection('codes', isPublished)).sort(byOrder);

const groups = [
  { kind: 'sdk', title: 'Development kits' },
  { kind: 'solver', title: 'Solvers' },
  { kind: 'tool', title: 'Tools' },
  { kind: 'library', title: 'Scientific libraries' },
  { kind: 'general', title: 'General-purpose libraries' },
] as const;
const shown = groups.map((g) => ({ ...g, items: codes.filter((c) => c.data.kind === g.kind) })).filter((g) => g.items.length > 0);
---

<Base title="Codes" description="Open-source simulation codes by Stefano Zaghi and co-authors.">
  <PageHead title="Codes" count={codes.length} lead="Open-source simulation software by Stefano Zaghi and co-authors." />
  {
    shown.map((g, k) => (
      <section class="sec">
        <p class="label mono">{String(k + 1).padStart(2, '0')} — {g.title}</p>
        <CodeRows codes={g.items} />
      </section>
    ))
  }
</Base>
