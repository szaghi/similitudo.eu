---
// A still frame of the mark (blast front + refined quadtree) as inline SVG, built at compile time. Decorative.
import type { Still } from '../lib/mesh/still';

interface Props {
  s: Still;
  par?: string; // preserveAspectRatio
}
const { s, par = 'xMaxYMid slice' } = Astro.props;
const widths = [1, 0.9, 0.75, 0.6, 0.5, 0.4];
---

<svg class="mesh-still" viewBox={`0 0 ${s.w} ${s.h}`} preserveAspectRatio={par} aria-hidden="true" focusable="false">
  <path class="base" d={s.base} fill="none" vector-effect="non-scaling-stroke"></path>
  {s.levels.map((g) => <path class="lvl" d={g.d} fill="none" stroke-width={widths[g.level] ?? 0.35} vector-effect="non-scaling-stroke" />)}
  <path class="ink" d={s.ink}></path>
</svg>

<style>
  .mesh-still { display: block; width: 100%; height: 100%; }
  .base { stroke: var(--grid); stroke-width: 1; }
  .lvl { stroke: var(--grid-fine); }
  .ink { fill: var(--stroke); }
</style>
