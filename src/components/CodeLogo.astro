---
// A code's sumi logo, washi version on light, silver-ink version on dark (BRAND.md: never swap them).
// A code without a logo yet gets a placeholder tile: the hairline grid of the logo tiles (same 64-unit frame) with the
// name's first two letters, and NO seal (the seal marks a finished identity). Inline SVG in currentColor, so it follows
// the theme by itself.
interface Props {
  folder?: string; // absent: the placeholder tile
  name: string;
  size?: number;
  decorative?: boolean; // next to the name it repeats: empty alt, so it is not read twice
}
import { langOf, t } from '../i18n';
const { folder, name, size = 96, decorative = false } = Astro.props;
const T = t(langOf(Astro.url));
const alt = decorative ? '' : T.ui.logo(name);
const initials = name.slice(0, 2);
const grid = [16, 32, 48].map((v) => `M${v} 0V64M0 ${v}H64`).join('');
---

<span class="code-logo" style={`width:${size}px;height:${size}px`}>
  {
    folder ? (
      <>
        <img class="light-only" src={`${folder}/logo.svg`} alt={alt} width={size} height={size} loading="lazy" />
        <img class="dark-only" src={`${folder}/logo-dark.svg`} alt={alt} width={size} height={size} loading="lazy" />
      </>
    ) : (
      <svg class="tile" viewBox="0 0 64 64" width={size} height={size} role={decorative ? undefined : 'img'}
           aria-hidden={decorative ? 'true' : undefined} aria-label={decorative ? undefined : T.ui.noLogo(name)}>
        <rect x="0.5" y="0.5" width="63" height="63" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
        <path d={grid} fill="none" stroke="currentColor" stroke-width="0.25" opacity="0.35" />
        <text x="32" y="33" text-anchor="middle" dominant-baseline="central">{initials}</text>
      </svg>
    )
  }
</span>

<style>
  .code-logo { display: inline-block; flex: none; }
  .tile { display: block; color: var(--text-3); }
  .tile text { fill: var(--text-1); font-family: var(--f-display); font-weight: 400; font-size: 22px; letter-spacing: -0.02em; }
</style>
