---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { isPublished, byOrder } from '../lib/content';

const codes = (await getCollection('codes', isPublished)).sort(byOrder).slice(0, 3);
---

<Base>
  <Hero />

  <section>
    <h2>For research consortia</h2>
    <!-- TODO: two or three sentences on the role similitudo plays in a proposal (partner profile). -->
    <p>
      similitudo joins research projects as the partner for numerical methods and high-performance simulation:
      designing the schemes, writing the solvers, porting them to GPUs and verifying the results.
    </p>
  </section>

  <section>
    <h2>Codes</h2>
    <div class="grid">
      {
        codes.map((c) => (
          <a class="card code" href={`/codes/${c.id}/`}>
            <h3>{c.data.name}</h3>
            <p class="muted">{c.data.tagline}</p>
          </a>
        ))
      }
    </div>
    <p><a href="/codes/">All codes →</a></p>
  </section>
</Base>

<style>
  .code { color: inherit; text-decoration: none; }
  .code:hover { border-color: var(--link); }
</style>
