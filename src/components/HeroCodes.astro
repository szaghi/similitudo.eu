---
// (owner, 2026-11-21) Every code's logo, small, as a pyramid under the hero nav's "Code", each a link to its code
// page. Ordered like /codes/, read from the apex down. Each icon sits on a plate of the ground, so the mesh stops at its
// edge (as the nav labels do). The icons are placed on a grid of half-icon columns, so the centred rows nest exactly.
// From 48rem it sits in the nav's Code item (Nav's `code` slot), centred on the label; `contain: inline-size` keeps it
// from widening that item. On phones "Code" is in the right column, too narrow to centre on: Hero renders a second copy
// below the whole nav (`phone`), and each copy hides itself at the other widths.
import { getCollection } from 'astro:content';
import CodeLogo from './CodeLogo.astro';
import { isPublished, byOrder } from '../lib/content';
import { langOf, t, href } from '../i18n';
interface Props {
  class?: string;
  phone?: boolean; // the copy shown below 48rem
}
const { class: cls, phone = false } = Astro.props;
const lang = langOf(Astro.url);
const T = t(lang);
const codes = (await getCollection('codes', isPublished)).sort(byOrder);

// Rows from the base up: BASE icons, then one fewer per row; the apex takes what is left (26 codes: 5 6 7 8).
const BASE = 8;
const rows: number[] = [];
for (let left = codes.length, len = BASE; left > 0; len = Math.max(1, len - 1)) {
  const r = Math.min(left, len);
  rows.unshift(r);
  left -= r;
}
const M = Math.max(...rows);
const place: { row: number; col: number }[] = []; // row, first half-column (1-based); each icon spans two
rows.forEach((len, r) => {
  for (let j = 0; j < len; j++) place.push({ row: r + 1, col: M - len + 1 + 2 * j });
});
---

<div class:list={['hero-codes', phone ? 'phone' : 'wide', cls]}>
  <ul aria-label={T.nav.code} style={`--halves:${2 * M}`}>
    {
      codes.map((c, i) => (
        <li style={`grid-area:${place[i].row} / ${place[i].col} / auto / span 2`}>
          <a href={href(lang, `/codes/${c.id}/`)} aria-label={c.data.name} title={c.data.name}>
            <CodeLogo folder={c.data.logo} name={c.data.name} size={32} decorative />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hero-codes { contain: inline-size; display: flex; justify-content: center; margin-top: 0.75rem; }
  .wide { display: none; }
  @media (min-width: 48rem) {
    .wide { display: flex; }
    .phone { display: none; }
  }
  ul {
    --half: 1.375rem; /* half the pitch: a 32 px icon, its plate and the gap */
    flex: none;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--halves), var(--half));
    row-gap: 0.35rem;
  }
  li { display: flex; justify-content: center; min-width: 0; }
  a {
    display: block;
    width: calc(100% - 0.4rem);
    padding: 3px;
    background: var(--bg);
    border-radius: 3px;
    transition: translate 0.15s, box-shadow 0.15s;
  }
  a :global(.code-logo) { display: block; width: 100% !important; height: auto !important; aspect-ratio: 1; }
  a :global(.code-logo img), a :global(.code-logo svg) { width: 100%; height: 100%; }
  a:hover, a:focus-visible { translate: 0 -2px; box-shadow: 0 0 0 1px var(--link); }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } a:hover, a:focus-visible { translate: none; } }
</style>
